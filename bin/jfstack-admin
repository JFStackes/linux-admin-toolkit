#!/usr/bin/env bash
# JFStack Linux Admin Toolkit
# https://jfstack.es
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/../lib/core.sh" ]]; then
  JFSTACK_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [[ -d /opt/jfstack-admin/lib ]]; then
  JFSTACK_ROOT='/opt/jfstack-admin'
else
  printf '[ERROR] Unable to locate JFStack Linux Admin Toolkit files.\n' >&2
  exit 1
fi
export JFSTACK_ROOT
# ShellCheck validates the shared library separately.
# shellcheck source=/dev/null
source "$JFSTACK_ROOT/lib/core.sh"

help_text() {
  cat <<EOF_HELP
JFStack Linux Admin Toolkit v$JFSTACK_VERSION

Usage:
  jfstack-admin                         Interactive administration menu
  jfstack-admin CATEGORY ACTION [...]  CLI mode
  jfstack-admin --version
  jfstack-admin --help

Categories and current v0.1 actions:
  user          create | info | expire | password | delete
  system        info
  service       status [SERVICE]
  process       top [cpu|mem]
  storage       info
  network       info | ports | test [TARGET]
  ssh           info | sessions
  firewall      status
  docker        status
  packages      updates
  logs          errors
  security      overview
  cert          check HOST[:PORT]
  backup        check PATH
  diagnose      [OUTPUT_FILE]
  maintenance   overview | large-dirs [PATH] [LIMIT] | large-files [PATH] [LIMIT]
                clean-cache | clean-updates | rotate-logs | clean-temp
                vacuum-journal [DAYS]

Maintenance scans default to / and 10 results (limit: 1-100).
Journal cleanup defaults to 30 days. Cleanup actions accept --dry-run or --yes.

Examples:
  sudo jfstack-admin user create takaka --expires 7d --docker --generate-password
  sudo jfstack-admin user create tech --expires none --sudo --public-key-file ~/.ssh/id_ed25519.pub
  sudo jfstack-admin user create vendor --expires 1m --generate-ssh-key
  jfstack-admin network ports
  jfstack-admin docker status
  jfstack-admin maintenance large-files /var 20
  jfstack-admin maintenance vacuum-journal 30 --dry-run
  sudo jfstack-admin diagnose /root/server-report.txt
EOF_HELP
}

interactive_menu() {
  while true; do
    clear 2>/dev/null || true
    banner
    printf ' Version : %s\n Host    : %s\n OS      : %s\n IP      : %s\n SSH     : %s\n' "$JFSTACK_VERSION" "$(hostname)" "$(os_pretty_name)" "$(primary_ip)" "$(ssh_port)"
    section 'ADMINISTRATION'
    cat <<'MENU'
  1) Users & Groups
  2) System
  3) Services
  4) Processes
  5) Storage
  6) Network
  7) SSH
  8) Firewall
  9) Docker
 10) Packages & Updates
 11) Logs
 12) Security
 13) Certificates
 14) Backups
 15) Diagnostics
 16) Analysis & Cleanup

  0) Exit
MENU
    printf '\n'
    read -r -p 'Select an option: ' choice || return 0
    case "$choice" in
      1) "$JFSTACK_ROOT/modules/users/menu.sh";;
      2) "$JFSTACK_ROOT/modules/system/menu.sh";;
      3) "$JFSTACK_ROOT/modules/services/menu.sh";;
      4) "$JFSTACK_ROOT/modules/processes/menu.sh";;
      5) "$JFSTACK_ROOT/modules/storage/menu.sh";;
      6) "$JFSTACK_ROOT/modules/network/menu.sh";;
      7) "$JFSTACK_ROOT/modules/ssh/menu.sh";;
      8) "$JFSTACK_ROOT/modules/firewall/menu.sh";;
      9) "$JFSTACK_ROOT/modules/docker/menu.sh";;
      10) "$JFSTACK_ROOT/modules/packages/menu.sh";;
      11) "$JFSTACK_ROOT/modules/logs/menu.sh";;
      12) "$JFSTACK_ROOT/modules/security/menu.sh";;
      13) "$JFSTACK_ROOT/modules/certificates/menu.sh";;
      14) "$JFSTACK_ROOT/modules/backups/menu.sh";;
      15) "$JFSTACK_ROOT/modules/diagnostics/menu.sh";;
      16) "$JFSTACK_ROOT/modules/maintenance/menu.sh";;
      0) exit 0;;
      *) warn 'Invalid option.'; sleep 1;;
    esac
  done
}

[[ $# -gt 0 ]] || { interactive_menu; exit 0; }
case "$1" in
  --help|-h|help) help_text ;;
  --version|-V) printf 'jfstack-admin %s\n' "$JFSTACK_VERSION" ;;
  user)
    action="${2:-}"; shift 2 || true
    case "$action" in
      create) exec "$JFSTACK_ROOT/modules/users/create-user.sh" "$@";;
      info) exec "$JFSTACK_ROOT/modules/users/user-info.sh" "$@";;
      expire) exec "$JFSTACK_ROOT/modules/users/expire-user.sh" "$@";;
      password) exec "$JFSTACK_ROOT/modules/users/reset-password.sh" "$@";;
      delete) exec "$JFSTACK_ROOT/modules/users/delete-user.sh" "$@";;
      *) error 'Unknown user action.'; help_text; exit 2;;
    esac ;;
  system)
    if [[ "${2:-}" == info ]]; then exec "$JFSTACK_ROOT/modules/system/summary.sh"; fi
    error 'Use: system info'; exit 2 ;;
  service)
    if [[ "${2:-}" == status ]]; then
      shift 2
      exec "$JFSTACK_ROOT/modules/services/status.sh" "$@"
    fi
    error 'Use: service status [SERVICE]'; exit 2 ;;
  process)
    if [[ "${2:-}" == top ]]; then exec "$JFSTACK_ROOT/modules/processes/top.sh" "${3:-cpu}"; fi
    error 'Use: process top [cpu|mem]'; exit 2 ;;
  storage)
    if [[ "${2:-}" == info ]]; then exec "$JFSTACK_ROOT/modules/storage/overview.sh"; fi
    error 'Use: storage info'; exit 2 ;;
  network)
    case "${2:-}" in info) exec "$JFSTACK_ROOT/modules/network/overview.sh";; ports) exec "$JFSTACK_ROOT/modules/network/ports.sh";; test) exec "$JFSTACK_ROOT/modules/network/test.sh" "${3:-1.1.1.1}";; *) error 'Use: network info|ports|test'; exit 2;; esac ;;
  ssh) case "${2:-}" in info) exec "$JFSTACK_ROOT/modules/ssh/overview.sh";; sessions) exec "$JFSTACK_ROOT/modules/ssh/sessions.sh";; *) error 'Use: ssh info|sessions'; exit 2;; esac ;;
  firewall)
    if [[ "${2:-}" == status ]]; then exec "$JFSTACK_ROOT/modules/firewall/overview.sh"; fi
    error 'Use: firewall status'; exit 2 ;;
  docker)
    if [[ "${2:-}" == status ]]; then exec "$JFSTACK_ROOT/modules/docker/overview.sh"; fi
    error 'Use: docker status'; exit 2 ;;
  packages)
    if [[ "${2:-}" == updates ]]; then exec "$JFSTACK_ROOT/modules/packages/overview.sh"; fi
    error 'Use: packages updates'; exit 2 ;;
  logs)
    if [[ "${2:-}" == errors ]]; then exec "$JFSTACK_ROOT/modules/logs/errors.sh"; fi
    error 'Use: logs errors'; exit 2 ;;
  security)
    if [[ "${2:-}" == overview ]]; then exec "$JFSTACK_ROOT/modules/security/overview.sh"; fi
    error 'Use: security overview'; exit 2 ;;
  cert)
    if [[ "${2:-}" == check ]]; then exec "$JFSTACK_ROOT/modules/certificates/check.sh" "${3:-}"; fi
    error 'Use: cert check HOST[:PORT]'; exit 2 ;;
  backup)
    if [[ "${2:-}" == check ]]; then exec "$JFSTACK_ROOT/modules/backups/check-path.sh" "${3:-}"; fi
    error 'Use: backup check PATH'; exit 2 ;;
  diagnose) exec "$JFSTACK_ROOT/modules/diagnostics/report.sh" "${2:-}" ;;
  maintenance)
    shift
    case "${1:-}" in
      overview) exec "$JFSTACK_ROOT/modules/maintenance/overview.sh" ;;
      large-dirs|large-files) exec "$JFSTACK_ROOT/modules/maintenance/scan.sh" "$@" ;;
      clean-cache|clean-updates|rotate-logs|vacuum-journal|clean-temp)
        exec "$JFSTACK_ROOT/modules/maintenance/cleanup.sh" "$@" ;;
      *) error 'Unknown maintenance action. See jfstack-admin --help.'; exit 2 ;;
    esac ;;
  *) error "Unknown category: $1"; help_text; exit 2 ;;
esac
